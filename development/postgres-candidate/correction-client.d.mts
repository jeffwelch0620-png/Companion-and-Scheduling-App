import type {Workspace} from '../../app/shared/types';
export type CorrectionWorkspace=Workspace & {scheduleRevision?:number};
export type Summary={start:string;end:string;position:string};
export type CorrectionRecord={id:string;kind:'shift-correction';locationId:string;ownerId:string;area:string;revision:number;updatedAt:string;data:{shiftId:string;sourceRevision:number;currentSourceRevision:number;employeeName:string;employeeNameAtEntry:string;historicalNameLabel:string;original:{id:string;member_id:string;department:string;revision:number;starts_at:string;ends_at:string;position:string};timezone:string;shiftLocalDate:string;effectiveLocalDate:string;effectiveSummary:Summary;appliedRevision:number;proposal:Summary;proposalBaseRevision:number;authorId:string;authorName:string;authorNameAtEntry:string;reason:string;decisionNote:string;status:'pending'|'applied'|'rejected'|'withdrawn';actions:{canPropose:boolean;canApprove:boolean;canReject:boolean;canWithdraw:boolean};warnings:{sourceChanged:boolean;hasOriginalTasks:boolean;hasOriginalClosings:boolean}}};
export type CompletedShift={shiftId:string;sourceRevision:number;currentSourceRevision:number;ownerId:string;area:string;employeeName:string;originalSummary:Summary;effectiveSummary:Summary;timezone:string;effectiveLocalDate:string;recordRevision:number;correction:CorrectionRecord|null;canPropose:boolean;correctionRevision:number};
export type CorrectionEvent={revision:number;action:string;actorId:string;actorName:string;actorNameAtEntry:string;historicalNameLabel:string;at:string;note:string;before:CorrectionEvent['after']|null;after:{status:string;effective_summary:Summary;proposal_summary:Summary;reason:string;decision_note:string}};
export type ReadStamp={actorId:string;locationId:string;accessKey:string;correctionRevision:number;scheduleRevision:number};
export type CorrectionBoard=ReadStamp & {sources:CompletedShift[];records:CorrectionRecord[];invalid:number;complete:boolean;asOf:string};
export type CorrectionDetail=ReadStamp & {source:CompletedShift|null;record:CorrectionRecord|null;events:CorrectionEvent[];complete:true};
export type CorrectionCall=(path:string)=>Promise<{status:number;body:any}>;
export const correctionReviewMessage:string;
export function hasCorrectionAccess(w:CorrectionWorkspace):boolean;
export function correctionAccessKey(w:CorrectionWorkspace):string;
export function correctionReadCurrent(w:CorrectionWorkspace,data:ReadStamp|null):boolean;
export function checkedCorrection(w:CorrectionWorkspace,r:unknown):CorrectionRecord;
export function checkedCompletedShift(w:CorrectionWorkspace,s:unknown):CompletedShift;
export function loadCorrectionBoard(call:CorrectionCall,w:CorrectionWorkspace):Promise<CorrectionBoard>;
export function loadCorrectionDetail(call:CorrectionCall,w:CorrectionWorkspace,key:string,options?:{source?:boolean}):Promise<CorrectionDetail>;
export function correctionFields(s:CompletedShift):Record<string,string>;
export function correctionInput(w:CorrectionWorkspace,s:CompletedShift,fields:Record<string,unknown>,now?:string):Record<string,unknown>;
export function correctionDecision(w:CorrectionWorkspace,r:CorrectionRecord,action:string,note:unknown):Record<string,unknown>;
